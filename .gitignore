# Mind Archive — files that must never enter version control.
#
# The two rules that matter most for a privacy-first project:
#   1. Never commit secrets (.env and friends).
#   2. Never commit the user's own archive data.
# Everything else here is ordinary build noise.

# ---------------------------------------------------------------
# Secrets and local configuration
# ---------------------------------------------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.p12
*.pfx
credentials.json
secrets.json

# ---------------------------------------------------------------
# The user's archive and local data
#
# Mind Archive stores your conversations and files on your own
# machine. None of it belongs in Git.
# ---------------------------------------------------------------
/data/
/archive/
apps/api/data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# Imported provider exports (ChatGPT, Claude, Gemini, ...)
*.zip
conversations.json
chat.html
user.json
message_feedback.json
model_comparisons.json

# The inbox: exports waiting to be imported, and the ones already done.
/data/inbox/

# Scratch space for real provider exports used while developing.
# Put your own ChatGPT export in local/ — everything in there is ignored
# except the README that explains what it is for.
/local/*
!/local/README.md

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------
node_modules/
apps/web/dist/
apps/web/.vite/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------------------------------------------------------------
# Editors and operating systems
# ---------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------
# Local scratch space
# ---------------------------------------------------------------
/tmp/

# Site pages generated from the repository's canonical documents by
# scripts/sync_site_pages.py — LICENSING.md, AGENTS.md, project-memory/ and the
# rest. Generated rather than committed so the published copy cannot drift from
# the file it came from (D-043). Regenerated before every build.
docs/reference/

# Jekyll build output from previewing the documentation site locally.
# GitHub Pages builds its own copy; this one is scratch.
docs/_site/
docs/.jekyll-cache/
docs/.jekyll-metadata
docs/Gemfile.lock
/scratch/
*.local
