---
layout: null
permalink: /feed.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<!--
  Hand-written rather than generated by jekyll-feed.

  jekyll-feed works on GitHub Pages but is not in the jekyll/jekyll image used
  to preview this site locally, so the local build and the published build
  would differ — the exact drift D-033 exists to prevent. This is a few lines
  of Liquid and behaves identically in both.
-->
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }}</title>
    <description>{{ site.description }}</description>
    <link>{{ '/' | absolute_url }}</link>
    <atom:link href="{{ '/feed.xml' | absolute_url }}" rel="self" type="application/rss+xml" />
    <language>en</language>
    {% if site.posts.size > 0 %}
      <lastBuildDate>{{ site.posts.first.date | date_to_rfc822 }}</lastBuildDate>
    {% endif %}
    {% for post in site.posts limit:20 %}
      <item>
        <title>{{ post.title | xml_escape }}</title>
        <description>{{ post.summary | default: post.excerpt | strip_html | xml_escape }}</description>
        <link>{{ post.url | absolute_url }}</link>
        <guid isPermaLink="true">{{ post.url | absolute_url }}</guid>
        <pubDate>{{ post.date | date_to_rfc822 }}</pubDate>
        {% for tag in post.tags %}
          <category>{{ tag | xml_escape }}</category>
        {% endfor %}
      </item>
    {% endfor %}
  </channel>
</rss>
