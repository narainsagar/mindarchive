# Normalise line endings so Windows, WSL, Linux and macOS contributors do not
# produce whole-file diffs against each other.

* text=auto eol=lf

# Shell scripts must keep LF endings or they will not run.
*.sh text eol=lf

# Windows batch files need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files: never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.woff binary
*.woff2 binary

# Keep generated lockfiles out of diffs and language statistics.
package-lock.json linguist-generated=true -diff
